# ---- 虚拟环境 ----
.venv/
env/
__pycache__/
*.py[cod]
*.egg-info/

# ---- 模型权重（数十 GB，绝不入库；用 tools/fetch_modelscope.py 拉）----
# 只有 LoRA 清单（触发词/推荐强度）要入库：它是元数据不是权重，
# 而且丢了前端就不知道该写什么词唤醒 LoRA。注意 Git 无法在被忽略的目录里
# 用 ! 反选，所以必须先放开 models/* 再放开 lora 子目录。
models/*
!models/lora/
models/lora/*
!models/lora/loras.json

# ---- 生成物 / 测试产物（可随时重建，不入库）----
assets/
*.log
*.jsonl

# ---- 测试与验证脚本的产物 ----
# 单独一个目录，不混进 assets/：assets/ 里放的是**项目要交付的东西**，
# 这里放的是开发过程的对比图、基准数据、pytest 的中间产物。
tests/_out/

# ---- 项目模板（用户自己的模板，不入库）----
templates/

# ---- 前端 ----
web/node_modules/
web/dist/
web/*.tsbuildinfo

# ---- 本地临时与缓存 ----
.workbuddy/
.cache/
huggingface/
*.incomplete
*.tmp

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
Thumbs.db
desktop.ini

# ---- 训练数据集 ----
dataset/

# ---- 前端 SSR 构建产物（骨骼编辑器预览用，见 tools/render_skeleton_preview.mjs）----
web/ssr-tmp/

# VNCCS MakeHuman 网格（37.8MB，CC0，从 ComfyUI_VNCCS_Utils 复制，不入库）
web/public/vnccs/
